{
  "name": "francys-portofolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "echo '==> Linting...' && TYPESCRIPT_ESLINT_SKIP_COMPAT_CHECK=true eslint  && echo '==> Prettying...' && prettier --write \"app/**/*.{ts,tsx,js,jsx,css}\" \"components/**/*.{ts,tsx,js,jsx,css}\" \"lib/**/*.{ts,tsx,js,jsx,css}\" \"utils/**/*.{ts,tsx,js,jsx,css}\" && next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:dev": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "lint": "TYPESCRIPT_ESLINT_SKIP_COMPAT_CHECK=true eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "hono": "^4.13.13",
    "lenis": "^1.3.26",
    "lucide-react": "^1.56.0",
    "motion": "^14.1.1",
    "next": "^16.4.0",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "type": "^2.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.150.0"
  },
  "packageManager": "pnpm@11.3.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "neverBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
